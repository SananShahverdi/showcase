# Local settings for smart-network-capacity-planner. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# CAPACITY_PLANNER_DATABASE_URL=sqlite:///./.local/state.sqlite3
# CAPACITY_PLANNER_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

CAPACITY_PLANNER_ENV=local
CAPACITY_PLANNER_LOG_LEVEL=INFO

# Project-specific
VITE_API_BASE_URL=http://localhost:8014/api
CAPACITY_STATE_FILE=./.local/capacity-state.json
