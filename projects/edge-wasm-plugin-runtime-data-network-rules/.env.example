# Local settings for edge-wasm-plugin-runtime-data-network-rules. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# EDGE_WASM_DATABASE_URL=sqlite:///./.local/state.sqlite3
# EDGE_WASM_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

EDGE_WASM_ENV=local
EDGE_WASM_LOG_LEVEL=INFO
