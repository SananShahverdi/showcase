# Local settings for real-time-fraud-risk-stream-analytics. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# REAL_TIME_FRAUD_DATABASE_URL=sqlite:///./.local/state.sqlite3
# REAL_TIME_FRAUD_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

REAL_TIME_FRAUD_ENV=local
REAL_TIME_FRAUD_LOG_LEVEL=INFO
