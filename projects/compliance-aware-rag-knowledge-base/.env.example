# Local settings for compliance-aware-rag-knowledge-base. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# COMPLIANCE_AWARE_RAG_KNOWLEDGE_BASE_DATABASE_URL=sqlite:///./.local/state.sqlite3
# COMPLIANCE_AWARE_RAG_KNOWLEDGE_BASE_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

COMPLIANCE_AWARE_RAG_KNOWLEDGE_BASE_ENV=local
COMPLIANCE_AWARE_RAG_KNOWLEDGE_BASE_LOG_LEVEL=INFO

# Project-specific
VITE_API_BASE_URL=http://localhost:8016/api
RAG_STATE_DIR=./.local/rag-state
