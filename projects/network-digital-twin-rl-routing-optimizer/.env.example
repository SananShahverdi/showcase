# Local settings for network-digital-twin-rl-routing-optimizer. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# NETWORK_DIGITAL_TWIN_DATABASE_URL=sqlite:///./.local/state.sqlite3
# NETWORK_DIGITAL_TWIN_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

NETWORK_DIGITAL_TWIN_ENV=local
NETWORK_DIGITAL_TWIN_LOG_LEVEL=INFO
