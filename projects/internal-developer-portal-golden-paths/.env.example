# Local settings for internal-developer-portal-golden-paths. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# INTERNAL_DEVELOPER_PORTAL_DATABASE_URL=sqlite:///./.local/state.sqlite3
# INTERNAL_DEVELOPER_PORTAL_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

INTERNAL_DEVELOPER_PORTAL_ENV=local
INTERNAL_DEVELOPER_PORTAL_LOG_LEVEL=INFO
