# Local settings for self-healing-public-data-intelligence-pipeline. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# SELF_HEALING_PUBLIC_DATA_INTELLIGENCE_PIPELINE_DATABASE_URL=sqlite:///./.local/state.sqlite3
# SELF_HEALING_PUBLIC_DATA_INTELLIGENCE_PIPELINE_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

SELF_HEALING_PUBLIC_DATA_INTELLIGENCE_PIPELINE_ENV=local
SELF_HEALING_PUBLIC_DATA_INTELLIGENCE_PIPELINE_LOG_LEVEL=INFO
