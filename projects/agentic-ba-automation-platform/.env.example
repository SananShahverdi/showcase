# Local settings for agentic-ba-automation-platform. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# AGENTIC_BA_AUTOMATION_PLATFORM_DATABASE_URL=sqlite:///./.local/state.sqlite3
# AGENTIC_BA_AUTOMATION_PLATFORM_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

AGENTIC_BA_AUTOMATION_PLATFORM_ENV=local
AGENTIC_BA_AUTOMATION_PLATFORM_LOG_LEVEL=INFO
