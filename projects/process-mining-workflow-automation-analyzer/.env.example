# Local settings for process-mining-workflow-automation-analyzer. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# PROCESS_MINING_DATABASE_URL=sqlite:///./.local/state.sqlite3
# PROCESS_MINING_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

PROCESS_MINING_ENV=local
PROCESS_MINING_LOG_LEVEL=INFO
