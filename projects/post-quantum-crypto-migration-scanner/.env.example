# Local settings for post-quantum-crypto-migration-scanner. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# PQC_SCANNER_DATABASE_URL=sqlite:///./.local/state.sqlite3
# PQC_SCANNER_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

PQC_SCANNER_ENV=local
PQC_SCANNER_LOG_LEVEL=INFO
