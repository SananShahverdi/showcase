# Local settings for autonomous-data-quality-observatory. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# DATA_QUALITY_DATABASE_URL=sqlite:///./.local/state.sqlite3
# DATA_QUALITY_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

DATA_QUALITY_ENV=local
DATA_QUALITY_LOG_LEVEL=INFO

# Project-specific
VITE_API_BASE_URL=http://localhost:8015/api
DATA_QUALITY_STATE_FILE=./.local/observatory-state.json
DATA_QUALITY_ALLOWED_DATA_DIR=./data
DATA_QUALITY_API_ALLOW_HOSTS=
