# Local settings for aiops-incident-assistant-human-approval. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# AIOPS_INCIDENT_ASSISTANT_DATABASE_URL=sqlite:///./.local/state.sqlite3
# AIOPS_INCIDENT_ASSISTANT_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

AIOPS_INCIDENT_ASSISTANT_ENV=local
AIOPS_INCIDENT_ASSISTANT_LOG_LEVEL=INFO
