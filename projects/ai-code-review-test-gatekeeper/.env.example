# Local settings for ai-code-review-test-gatekeeper. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# AI_CODE_REVIEW_DATABASE_URL=sqlite:///./.local/state.sqlite3
# AI_CODE_REVIEW_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

AI_CODE_REVIEW_ENV=local
AI_CODE_REVIEW_LOG_LEVEL=INFO
