# Local settings for local-ai-inference-gateway-llmops-console. Copy to .env (git-ignored); never commit real secrets.

# Persistence. Unset = in-memory (resets on restart). Docker Compose sets SQLite by default.
# LOCAL_AI_INFERENCE_GATEWAY_LLMOPS_CONSOLE_DATABASE_URL=sqlite:///./.local/state.sqlite3
# LOCAL_AI_INFERENCE_GATEWAY_LLMOPS_CONSOLE_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required only for compose.postgres.yml. Choose your own value.
POSTGRES_PASSWORD=

LOCAL_AI_INFERENCE_GATEWAY_LLMOPS_CONSOLE_ENV=local
LOCAL_AI_INFERENCE_GATEWAY_LLMOPS_CONSOLE_LOG_LEVEL=INFO

# HMAC pepper for gateway API key hashes. Set a long random value outside local development.
GATEWAY_KEY_PEPPER=
